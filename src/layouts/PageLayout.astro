---
/**
 * PageLayout — BaseLayout plus the page's heading and optional breadcrumbs.
 *
 * Every page that is not the home page goes through this, so that the single
 * <h1> and the heading order are structural rather than something each page
 * has to remember.
 *
 * Phase 9 added the `BreadcrumbList` JSON-LD, and it is built from `trail` — the
 * SAME array the visible breadcrumb renders from — so the two cannot describe
 * different paths. It is emitted only when that breadcrumb is actually on the
 * page: structured data that describes a trail the reader cannot see is exactly
 * the mismatch Google's guidance warns about, and it would be the only piece of
 * structured data on this site not backed by something visible. `FaqGroups`
 * follows the same rule for `FAQPage`.
 *
 * The last item deliberately carries no `item` URL. It is the current page, and
 * Google's own examples end the list that way.
 */
import BaseLayout from './BaseLayout.astro'
import { site } from '../config/site'
import { path, useTranslations } from '../i18n/utils'
import type { RouteKey } from '../i18n/routes'
import type { Locale } from '../i18n/ui'

interface Crumb {
  label: string
  href: string
}

interface Props {
  /** The page-specific part of the <title>. The brand suffix is composed in
      BaseLayout — never author it here. See CLAUDE.md, "The brand name". */
  title: string
  description: string
  locale: Locale
  routeKey: RouteKey
  /** Forwarded to BaseLayout, which owns the suffix. See the contract there. */
  brandSuffix?: boolean
  /** The visible <h1>. Distinct from `title`, which is the <title> tag. */
  heading: string
  /** Intermediate crumbs. Home is prepended and the current page is not a link. */
  crumbs?: Crumb[]
  lead?: string
  ogImage?: string
  noindex?: boolean
  /** Forwarded to BaseLayout. See the contracts there. */
  alternates?: readonly { locale: Locale; href: string }[]
  jsonLd?: readonly Record<string, unknown>[]
}

const {
  title,
  description,
  locale,
  routeKey,
  brandSuffix,
  heading,
  crumbs = [],
  lead,
  ogImage,
  noindex,
  alternates,
  jsonLd,
} = Astro.props
const t = useTranslations(locale)

const showCrumbs = routeKey !== 'home'
const trail: Crumb[] = [{ label: t('nav.home'), href: path('home', locale) }, ...crumbs]

const breadcrumbVisible = showCrumbs && crumbs.length > 0

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    ...trail.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.label,
      item: new URL(crumb.href, site.domain).href,
    })),
    { '@type': 'ListItem', position: trail.length + 1, name: heading },
  ],
}

/* Prepended, so a page's own structured data still follows it in the head. */
const allJsonLd = breadcrumbVisible ? [breadcrumbLd, ...(jsonLd ?? [])] : jsonLd
---
<BaseLayout
  title={title}
  description={description}
  locale={locale}
  routeKey={routeKey}
  brandSuffix={brandSuffix}
  ogImage={ogImage}
  noindex={noindex}
  alternates={alternates}
  jsonLd={allJsonLd}
>
  <div class="page">
    <div class="wrap">
      {showCrumbs && crumbs.length > 0 && (
        <nav class="page__crumbs" aria-label={t('a11y.breadcrumb')}>
          <ol>
            {trail.map((crumb) => (
              <li><a href={crumb.href}>{crumb.label}</a></li>
            ))}
            <li aria-current="page">{heading}</li>
          </ol>
        </nav>
      )}
      <h1>{heading}</h1>
      {lead && <p class="lead page__lead">{lead}</p>}
    </div>
  </div>
  <slot />
</BaseLayout>

<style>
  .page {
    padding-block: var(--sp-10) var(--sp-8);
  }

  .page__crumbs {
    margin-block-end: var(--sp-5);
    font-size: var(--step-xs);
    color: var(--muted);
  }

  .page__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .page__crumbs li + li::before {
    content: '/';
    margin-inline-end: var(--sp-2);
  }

  .page__crumbs a {
    color: var(--muted);
  }

  .page__crumbs a:hover {
    color: var(--ink-2);
  }

  .page__lead {
    margin-block-start: var(--sp-5);
  }
</style>
