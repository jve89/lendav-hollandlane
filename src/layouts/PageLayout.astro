---
/**
 * PageLayout — BaseLayout plus the page's heading and optional breadcrumbs.
 *
 * Every page that is not the home page goes through this, so that the single
 * <h1> and the heading order are structural rather than something each page
 * has to remember. Breadcrumbs are visual only; BreadcrumbList JSON-LD is
 * Phase 9.
 */
import BaseLayout from './BaseLayout.astro'
import { path, useTranslations } from '../i18n/utils'
import type { RouteKey } from '../i18n/routes'
import type { Locale } from '../i18n/ui'

interface Crumb {
  label: string
  href: string
}

interface Props {
  title: string
  description: string
  locale: Locale
  routeKey: RouteKey
  /** The visible <h1>. Distinct from `title`, which is the <title> tag. */
  heading: string
  /** Intermediate crumbs. Home is prepended and the current page is not a link. */
  crumbs?: Crumb[]
  lead?: string
  ogImage?: string
  noindex?: boolean
  /** Forwarded to BaseLayout. See the contracts there. */
  alternates?: readonly { locale: Locale; href: string }[]
  jsonLd?: readonly Record<string, unknown>[]
}

const {
  title,
  description,
  locale,
  routeKey,
  heading,
  crumbs = [],
  lead,
  ogImage,
  noindex,
  alternates,
  jsonLd,
} = Astro.props
const t = useTranslations(locale)

const showCrumbs = routeKey !== 'home'
const trail: Crumb[] = [{ label: t('nav.home'), href: path('home', locale) }, ...crumbs]
---
<BaseLayout
  title={title}
  description={description}
  locale={locale}
  routeKey={routeKey}
  ogImage={ogImage}
  noindex={noindex}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <div class="page">
    <div class="wrap">
      {showCrumbs && crumbs.length > 0 && (
        <nav class="page__crumbs" aria-label={t('a11y.breadcrumb')}>
          <ol>
            {trail.map((crumb) => (
              <li><a href={crumb.href}>{crumb.label}</a></li>
            ))}
            <li aria-current="page">{heading}</li>
          </ol>
        </nav>
      )}
      <h1>{heading}</h1>
      {lead && <p class="lead page__lead">{lead}</p>}
    </div>
  </div>
  <slot />
</BaseLayout>

<style>
  .page {
    padding-block: var(--sp-10) var(--sp-8);
  }

  .page__crumbs {
    margin-block-end: var(--sp-5);
    font-size: var(--step-xs);
    color: var(--muted);
  }

  .page__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .page__crumbs li + li::before {
    content: '/';
    margin-inline-end: var(--sp-2);
  }

  .page__crumbs a {
    color: var(--muted);
  }

  .page__crumbs a:hover {
    color: var(--ink-2);
  }

  .page__lead {
    margin-block-start: var(--sp-5);
  }
</style>
