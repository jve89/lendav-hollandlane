---
import '../styles/tokens.css'
import '../styles/global.css'

import { site } from '../config/site'
import { alternates, bcp47, otherLocale, useTranslations } from '../i18n/utils'
import { defaultLocale, type Locale } from '../i18n/ui'
import type { RouteKey } from '../i18n/routes'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  /**
   * The page-specific part of the <title>, WITHOUT the brand.
   *
   * The ` | <brand>` suffix is composed below from `site.brandText`. Do not
   * author it here or in any string that reaches this prop — the business name
   * is not settled, and sixteen authored copies of it is the drift the
   * single-source rule exists to prevent. See CLAUDE.md, "The brand name".
   */
  title: string
  description: string
  locale: Locale
  routeKey: RouteKey
  /**
   * Suppresses the brand suffix, for a page whose title already carries the
   * brand — one written brand-first, for instance.
   *
   * It suppresses the suffix; it does NOT license typing the brand into a
   * string. The name comes from `site.brandText` in that case too. No page
   * sets this today.
   */
  brandSuffix?: boolean
  ogImage?: string
  /** `overlay` floats the nav pill over a hero. Only the home page needs it. */
  headerVariant?: 'overlay' | 'solid'
  noindex?: boolean
  /**
   * Overrides the hreflang set and the language switch target.
   *
   * A page whose slug is localised per locale cannot resolve its alternates
   * from a `RouteKey`, because the route key names only the index: a service
   * page would otherwise advertise `/teenused` and `/en/services` rather than
   * `/teenused/katusepesu` and `/en/services/roof-cleaning`. Content-derived
   * routes build this with `localisedAlternates` in `i18n/collections.ts`.
   */
  alternates?: readonly { locale: Locale; href: string }[]
  /**
   * Additional JSON-LD, one `<script>` block each, alongside the sitewide
   * `LocalBusiness`. No page writes its own `<head>` — ARCHITECTURE section 6 —
   * so structured data arrives as data and is serialised here, in the one file
   * that knows how to do it safely.
   */
  jsonLd?: readonly Record<string, unknown>[]
}

// `alternates` is destructured under another name because the identifier is
// already taken by the import above; shadowing it would break the fallback.
const {
  title,
  description,
  locale,
  routeKey,
  brandSuffix = true,
  ogImage,
  headerVariant = 'solid',
  noindex = false,
  alternates: alternatesOverride,
  jsonLd: extraJsonLd = [],
} = Astro.props
const t = useTranslations(locale)
const alts = alternatesOverride ?? alternates(routeKey)

/**
 * THE BRAND SUFFIX IS COMPOSED HERE, IN ONE PLACE, AND NOWHERE ELSE.
 *
 * Every <title> on the site passes through this layout — directly, or through
 * PageLayout, which only forwards. So this is the one expression that decides
 * what the brand looks like in a title, and `site.brandText` is the one place
 * that decides what it is called.
 *
 * It was authored sixteen times before this: the seoTitle of all ten service
 * content files and six meta title strings in ui.ts. The name is still being
 * decided, and every later phase would have added more copies.
 *
 * <title> and og:title are both built from this, so they cannot drift apart.
 */
const documentTitle = brandSuffix ? `${title} | ${site.brandText}` : title

/* Found by locale rather than taken as `alts[0]`, so an override that lists the
   locales in a different order cannot silently point x-default at English. */
const xDefault = alts.find((a) => a.locale === defaultLocale) ?? alts[0]!
const langHref = alts.find((a) => a.locale === otherLocale(locale))?.href

/**
 * CANONICAL COMES FROM THE SAME ARRAY AS HREFLANG, and this is the point.
 *
 * It used to be built from `Astro.url.pathname`, which under the directory
 * build format ends in a slash — so a page advertised itself as
 * `…/teenused/katusepesu/` in canonical and `…/teenused/katusepesu` in its own
 * et-EE alternate. Two URLs for one page, from two sources that had no reason
 * to agree. Taking the self-referencing alternate makes them the same string by
 * construction rather than by discipline.
 *
 * The form is NO TRAILING SLASH, except the Estonian home page, which is `/`.
 * That is what `routes.ts` declares, what every internal link emits, and what
 * `serviceHref` builds, so it is the form the site already speaks. The sitemap
 * is normalised to match in `astro.config.mjs`.
 */
const selfHref = alts.find((a) => a.locale === locale)?.href ?? Astro.url.pathname
const canonical = new URL(selfHref, site.domain).href

/**
 * Serialises structured data for a `<script>` body. `JSON.stringify` does not
 * escape `<`, so an authored string containing `</script>` would close the tag
 * and spill the rest of the object onto the page. `<` is valid JSON, so
 * the escape is invisible to any parser — including the one in
 * `scripts/check-html.mjs`.
 */
const ld = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c')

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  /* Referenced by `Service.provider` on the service pages, so a service page
     emits one connected graph rather than two unrelated objects. */
  '@id': `${site.domain}/#business`,
  name: site.brandText,
  legalName: site.legalName,
  url: site.domain,
  telephone: site.phone,
  /* NO `email` KEY. It was here until Phase 6, publishing an address on an
     unregistered domain as a machine-readable contact — the copy that
     propagates furthest into aggregators and is hardest to retract. Structured
     data must not assert what the page will not. Restore it in one line when
     `site.email` works; see the `unconfirmed:` comment in site.ts. */
  areaServed: { '@type': 'Country', name: 'Estonia' },
  priceRange: '€€',
}
---
<!DOCTYPE html>
<html lang={bcp47(locale)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{documentTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {/* No `theme-color` meta: it would mean writing --bg's hex a second time,
      outside tokens.css. It belongs with the favicon and touch icons in Phase 9. */}
  {alts.map((a) => (
    <link rel="alternate" hreflang={bcp47(a.locale)} href={new URL(a.href, site.domain).href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(xDefault.href, site.domain).href} />
  <meta property="og:title" content={documentTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, site.domain).href} />}
  <script type="application/ld+json" is:inline set:html={ld(jsonLd)} />
  {extraJsonLd.map((block) => (
    <script type="application/ld+json" is:inline set:html={ld(block)} />
  ))}
</head>
<body>
  <a class="skip-link" href="#main">{t('a11y.skip')}</a>
  <Header locale={locale} routeKey={routeKey} variant={headerVariant} langHref={langHref} />
  <main id="main">
    <slot />
  </main>
  <Footer locale={locale} routeKey={routeKey} />
</body>
</html>
