---
/**
 * ServiceCard — one card in a services grid, on the paper section.
 *
 * Since Phase 4 the data comes from the `services` content collection rather
 * than an array in `i18n/home.ts`, on both the home pages and the services
 * index. `title`, `body` and `priceKind` are the same three props they always
 * were; only their source changed.
 *
 * It never receives a price. It receives a `priceKind` and `priceLine` resolves
 * it against `site.prices`, so no euro amount is typed into a copy file, a
 * markdown file or a page. The "alates" / "From" prefix is mandatory on per-m²
 * prices — CLAUDE.md, pricing rules — and the ex-VAT label sits once per
 * section rather than once per card.
 *
 * THE LINK IS THE TITLE, NOT THE CARD. The `<a>` wraps the heading text alone,
 * so its accessible name is the service title and nothing else; the rest of the
 * card becomes a click target through an `::after` overlay on that link. A card
 * wrapped in an anchor would give a screen reader an accessible name made of
 * the title, the body and the price run together.
 *
 * `headingLevel` exists because the same card sits at two depths: under an
 * `<h2>` section heading on the home page, and directly under the page `<h1>`
 * on the services index, where an `<h3>` would skip a level. CLAUDE.md requires
 * headings in order.
 */
import type { PriceKind, ServiceIcon } from '../i18n/home'
import { priceLine } from '../i18n/utils'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  title: string
  body: string
  icon: ServiceIcon
  priceKind: PriceKind
  /** Where the card goes. Required: a service card with nowhere to go is a bug. */
  href: string
  /** 3 under a section heading, 2 when the card sits directly under the page h1. */
  headingLevel?: 2 | 3
}

const { locale, title, body, icon, priceKind, href, headingLevel = 3 } = Astro.props
const Heading = `h${headingLevel}` as 'h2' | 'h3'
---
<li class="card service">
  <span class="service__icon" aria-hidden="true">
    {icon === 'roof' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
        <path d="M3 11l9-8 9 8" />
        <path d="M5 10v10h14V10" />
      </svg>
    )}
    {icon === 'facade' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
        <rect x="4" y="3" width="16" height="18" rx="1" />
        <path d="M4 9h16M4 15h16M12 3v18" />
      </svg>
    )}
    {icon === 'solar' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9L7 7M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1" />
      </svg>
    )}
    {icon === 'glass' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <path d="M3 9h18M9 21V9" />
      </svg>
    )}
    {icon === 'gutter' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
        <path d="M4 7h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V7z" />
        <path d="M12 14v6" />
      </svg>
    )}
  </span>

  <Heading><a class="service__link" href={href}>{title}</a></Heading>
  <p class="service__body">{body}</p>
  <p class="service__price">{priceLine(priceKind, locale)}</p>
</li>

<style>
  /* The card sets its own track width so a trailing row of two keeps exactly the
     width of a full row of three, rather than stretching to fill. `--card-gap`
     is inherited from the grid container, so the two never drift apart.
     `position: relative` is what the link's overlay is positioned against. */
  .service {
    display: flex;
    flex-direction: column;
    flex: 1 1 100%;
    position: relative;
    transition: border-color 0.15s ease;
  }

  .service:hover {
    border-color: var(--accent-wash-line);
  }

  @media (min-width: 760px) {
    .service {
      flex: 0 1 calc((100% - var(--card-gap, var(--sp-5))) / 2);
    }
  }

  @media (min-width: 1000px) {
    .service {
      flex: 0 1 calc((100% - 2 * var(--card-gap, var(--sp-5))) / 3);
    }
  }

  /* An h2 here is a depth signal, not a size change — the card title reads the
     same whichever level the calling page needs it to be. */
  .service :is(h2, h3) {
    font-size: var(--step-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-h3);
    font-weight: var(--fw-strong);
  }

  .service__link {
    text-decoration: none;
  }

  /* Extends the link's hit area over the whole card without extending its
     accessible name. The focus ring stays on the title text, which is where the
     focused element actually is. */
  .service__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .service__icon {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    border-radius: var(--r-chip);
    background: var(--accent-wash);
    border: 1px solid var(--accent-wash-line);
    color: var(--accent-on-paper);
    margin-block-end: var(--sp-4);
  }

  .service__icon svg {
    inline-size: 20px;
    block-size: 20px;
  }

  .service__body {
    margin-block-start: var(--sp-2);
    color: var(--paper-muted);
    font-size: var(--step-sm);
    /* Pushes the price to the foot of the card, so a short body and a long one
       still line their prices up across the row. */
    flex: 1 0 auto;
  }

  .service__price {
    margin-block-start: var(--sp-5);
    padding-block-start: var(--sp-4);
    border-block-start: 1px dashed var(--paper-line);
    color: var(--accent-on-paper);
    font-weight: var(--fw-display);
  }
</style>
