---
/**
 * InspectionPricing — the pointer under the washing price table on
 * `/hinnakiri` and `/en/pricing`.
 *
 * A BLOCK AFTER THE TABLE, NEVER A ROW IN IT. This is the sharpest form of the
 * pointer-never-member rule in SPEC section 11: every row of that table carries
 * a per-m² from-price or a `priceKind` resolved against `site.prices`, so an
 * inspection row would imply a square-metre price for work that does not have
 * one — and `PriceTable` could not render it anyway without inspection becoming
 * a `serviceKey`, which is forbidden for exactly this reason.
 *
 * NO FIGURE APPEARS HERE AND NONE MAY BE ADDED. The copy says the work is quoted
 * per job and what the quote depends on, which is the same answer the industrial
 * service page gives and is true. `site.ts` holds no inspection price; SPEC
 * section 11 constraint 5 forbids one, and this component must never be the
 * place one arrives. It also says nothing about turnaround, and nothing about
 * whether the work is free or paid.
 *
 * A separate component from the other two pointers because it is the only one
 * that has to answer a pricing question. Copy in `i18n/inspection.ts`.
 */
import { inspectionPointer } from '../i18n/inspection'
import { path } from '../i18n/utils'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = inspectionPointer('pricing', locale)
const href = path('inspection', locale)
---
<div class="insp-price">
  <h2 class="insp-price__heading">{c.heading}</h2>
  {c.body.map((paragraph) => <p class="insp-price__body">{paragraph}</p>)}
  <p class="insp-price__cta"><a href={href}>{c.cta}</a></p>
</div>

<style>
  /* Separated from the table by a rule, so it cannot read as a footnote to it —
     the same device `InspectionNote` uses under the services grid, and for the
     same reason: what is above is the washing set, what is below is not part
     of it. */
  .insp-price {
    margin-block-start: var(--sp-8);
    padding-block-start: var(--sp-7);
    border-block-start: 1px solid var(--line);
    max-width: var(--measure);
  }

  .insp-price__heading {
    font-size: var(--step-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-h3);
    font-weight: var(--fw-strong);
  }

  .insp-price__body {
    margin-block-start: var(--sp-3);
    color: var(--ink-2);
    font-size: var(--step-sm);
    line-height: var(--lh-body);
  }

  .insp-price__cta {
    margin-block-start: var(--sp-4);
    font-size: var(--step-sm);
    font-weight: var(--fw-strong);
  }

  .insp-price__cta a {
    color: var(--accent-text);
  }
</style>
