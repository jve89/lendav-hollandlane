---
/**
 * Credentials — the body of `/meist`: what we hold, who holds it, and the
 * company's identifiers.
 *
 * Extracted so the two locale pages stay in step, like `ServiceGrid` and
 * `PricingDetails`.
 *
 * EVERY FACT ON THIS PAGE IS READ, NOT TYPED. The prose comes from
 * `i18n/about.ts` with its tokens resolved from `site.ts` — the operator, the
 * legal name, the authority, the exact authorisation and insurance references,
 * the service area, the season. The identifiers block below reads `site.ts`
 * directly. Nothing here is a second copy of anything.
 *
 * THIS IS THE PAGE WHERE THE EXACT REGULATORY REFERENCES BELONG, and the only
 * one. CLAUDE.md keeps `SORA`, `SAIL II` and the insurance regulation out of
 * hero copy, badges and homeowner body text, because a homeowner does not know
 * what SAIL II is and will not look it up. Here the reader has come looking for
 * documents and the precision is the point.
 *
 * THE EMAIL ADDRESS IS PRINTED HERE, in the identifiers block with the registry
 * and VAT numbers. It was suppressed from Phase 6 until 26 July 2026 because it
 * received no mail; Cloudflare Email Routing is configured and tested now. This
 * is the page a KÜ board or a property manager comes to for documents, so a
 * written route belongs beside the identifiers. The page's primary ask is still
 * `Cta`, which it renders after this and which points at the quote form.
 */
import { site } from '../config/site'
import { aboutSections } from '../i18n/about'
import { useTranslations } from '../i18n/utils'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const sections = aboutSections(locale)
---
<div class="creds">
  {sections.map((section) => (
    <section class="creds__block">
      <h2 class="creds__heading">{section.heading}</h2>
      {section.body.map((paragraph) => <p class="creds__para">{paragraph}</p>)}
    </section>
  ))}

  <section class="creds__block">
    <h2 class="creds__heading">{t('footer.companyTitle')}</h2>
    <dl class="creds__ids">
      <dt class="visually-hidden">{t('footer.companyTitle')}</dt>
      <dd>{site.legalName}</dd>
      <dt>{t('footer.regCode')}</dt>
      <dd>{site.regCode}</dd>
      <dt>{t('footer.vatNumber')}</dt>
      <dd>{site.vatNumber}</dd>
      <dt>{t('footer.emailTitle')}</dt>
      <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
    </dl>
  </section>
</div>

<style>
  .creds {
    display: grid;
    gap: var(--sp-9);
    max-width: var(--measure-wide);
  }

  .creds__heading {
    font-size: var(--step-prose-h2);
    letter-spacing: var(--ls-h3);
  }

  .creds__para {
    margin-block-start: var(--sp-4);
    max-width: var(--measure);
    color: var(--ink-3);
  }

  /* The identifiers read as a document, not as prose: label above value, in the
     same shape the footer uses, so the two cannot look like different claims. */
  .creds__ids {
    margin-block-start: var(--sp-5);
    display: grid;
    gap: var(--sp-1);
    font-size: var(--step-sm);
    color: var(--ink-2);
  }

  .creds__ids dt {
    color: var(--muted);
    font-size: var(--step-xs);
  }

  .creds__ids dt:not(.visually-hidden) {
    margin-block-start: var(--sp-3);
  }

  .creds__ids dd {
    color: var(--ink);
    font-weight: var(--fw-strong);
  }
</style>
