---
/**
 * Faq — an excerpt of three questions on the home page. Native <details>, so
 * this costs zero bytes of JavaScript (ARCHITECTURE section 2).
 *
 * Which three: roof damage, weather and season, cleaning frequency. The
 * chemicals answer and the water-and-power answer are deliberately NOT here —
 * both are unconfirmed and PLAN puts their visible TODO markers on the service
 * pages (Phase 4) and the FAQ page (Phase 5), where a reader has come looking
 * for detail. Putting an unanswerable question on the highest-traffic page
 * would spend attention the price and the benefit need.
 *
 * There is no "all questions" link yet: /kkk does not exist until Phase 5, and
 * `npm run links` correctly fails on a link to a page that is not built.
 *
 * The season is interpolated from site.ts via `monthRange`, so no month name is
 * typed into this repository and Russian remains a translation drop.
 */
import { site } from '../config/site'
import { homeCopy } from '../i18n/home'
import { monthRange } from '../i18n/utils'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = homeCopy[locale].faq
const season = monthRange(site.season.fromMonth, site.season.toMonth, locale)

const items = c.items.map((item) => ({
  q: item.q,
  a: item.a.replace('{season}', season),
}))
---
<section class="section section--raised faq">
  <div class="wrap faq__wrap">
    <h2>{c.heading}</h2>

    <div class="faq__list">
      {items.map((item) => (
        <details class="faq__item">
          <summary class="faq__q">
            <span>{item.q}</span>
            <span class="faq__mark" aria-hidden="true"></span>
          </summary>
          <p class="faq__a">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__wrap {
    max-width: 820px;
  }

  .faq__list {
    margin-block-start: var(--sp-7);
    display: grid;
    gap: var(--sp-3);
  }

  .faq__item {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    padding: var(--sp-4) var(--sp-5);
    font-weight: var(--fw-strong);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  /* A drawn mark rather than a glyph, so it needs no icon font and rotates
     cleanly. It is decoration: the <details> element already announces state. */
  .faq__mark {
    position: relative;
    flex: none;
    inline-size: 12px;
    block-size: 12px;
  }

  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    inline-size: 12px;
    block-size: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: translateY(-50%);
  }

  .faq__mark::after {
    transform: translateY(-50%) rotate(90deg);
    transition: transform 0.15s ease;
  }

  .faq__item[open] .faq__mark::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .faq__a {
    padding: 0 var(--sp-5) var(--sp-5);
    color: var(--ink-3);
    font-size: var(--step-sm);
  }
</style>
