---
/**
 * Faq — the home page's FAQ excerpt: three questions and a link to the rest.
 *
 * SINCE PHASE 5 IT DOES NOT OWN ITS COPY. The questions live in `i18n/faq.ts`,
 * which is also what `/kkk` renders and what `services.faqRefs` names. This
 * component selects by id and defaults to `homeFaqIds` — roof damage, weather
 * and season, cleaning frequency: the three objections a homeowner arrives
 * with.
 *
 * The unconfirmed three (cleaning product, water and power, duration) are
 * deliberately not among them. Each is answered with a commitment about our own
 * conduct rather than a fact, which is the right answer on a page a reader
 * reached looking for detail and the wrong one on the highest-traffic page in
 * the site.
 *
 * The disclosure markup moved to `FaqList.astro`, because `/kkk` renders the
 * same list three times under three group headings.
 */
import FaqList from './FaqList.astro'
import { homeFaqIds, type FaqId } from '../i18n/faq'
import { builtRoutes } from '../i18n/routes'
import { path, useTranslations } from '../i18n/utils'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  /** Which questions to show, in order. Defaults to the home page's three. */
  ids?: readonly FaqId[]
}

const { locale, ids = homeFaqIds } = Astro.props
const t = useTranslations(locale)

/**
 * The link to the full FAQ appears only once `/kkk` is built. `npm run links`
 * correctly fails on a link to a page that does not exist, and `builtRoutes` is
 * how every component in this repository asks that question — the same pattern
 * `Hero` and `Cta` use for the quote route.
 */
const allHref = builtRoutes.has('faq') ? path('faq', locale) : undefined
---
<section class="section faq">
  <div class="wrap faq__wrap">
    <h2>{t('faq.heading')}</h2>

    <div class="faq__body">
      <FaqList locale={locale} ids={ids} />
    </div>

    {allHref && <p class="faq__all"><a href={allHref}>{t('faq.all')}</a></p>}
  </div>
</section>

<style>
  .faq__wrap {
    max-width: 820px;
  }

  .faq__body {
    margin-block-start: var(--sp-7);
  }

  .faq__all {
    margin-block-start: var(--sp-6);
    font-size: var(--step-sm);
    font-weight: var(--fw-strong);
  }

  .faq__all a {
    color: var(--accent-text);
    text-underline-offset: 0.2em;
  }
</style>
