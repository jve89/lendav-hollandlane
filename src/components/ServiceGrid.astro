---
/**
 * ServiceGrid — the service cards, from the content collection.
 *
 * Extracted in Phase 4. The list and its flex rules previously sat inline in
 * both home pages; the services index in two locales would have made four
 * copies of the same markup and the same layout reasoning. The reasoning is the
 * part worth keeping in one place — see the comment on `.services__grid`.
 *
 * It takes entries rather than fetching them, so a caller can decide the order
 * and the subset. Every current caller passes `servicesFor(locale)`, which is
 * all six in `order`.
 */
import type { CollectionEntry } from 'astro:content'
import ServiceCard from './ServiceCard.astro'
import { serviceHref } from '../i18n/services'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  entries: readonly CollectionEntry<'services'>[]
  /** Passed through to each card. 2 when the grid sits directly under a page h1. */
  headingLevel?: 2 | 3
}

const { locale, entries, headingLevel = 3 } = Astro.props
---
<ul class="services__grid">
  {entries.map((entry) => (
    <ServiceCard
      locale={locale}
      title={entry.data.title}
      body={entry.data.summary}
      icon={entry.data.icon}
      priceKind={entry.data.priceKind}
      href={serviceHref(locale, entry.data.slug)}
      headingLevel={headingLevel}
    />
  ))}
</ul>

<style>
  /* Flex, not grid, and the reason is a trailing row that does not fill.
     Six services divide evenly three-up, so there is no ragged row TODAY — but
     five left a trailing row of two, seven would leave one, and a grid would
     stretch whatever was left across the full width. Each card sets its own
     track width from `--card-gap`, so a short row keeps exactly the width of a
     full one and the ragged edge stays centred. Do not simplify this to a grid
     on the strength of the count happening to divide right now. */
  .services__grid {
    --card-gap: var(--sp-5);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--card-gap);
  }
</style>
