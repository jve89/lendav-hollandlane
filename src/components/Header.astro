---
/**
 * Header — the floating glass pill navigation from reference/direction-d.html.
 *
 * Two variants:
 *   overlay — absolutely positioned over a hero, as in direction D. The home
 *             page passes this in Phase 2.
 *   solid   — the same pill in normal flow, for every page that has no hero.
 *             The default, because most pages do not have one.
 *
 * Zero JavaScript. The mobile menu is a native <details>, the same mechanism
 * ARCHITECTURE section 2 uses for the FAQ. Trade-off, accepted in Phase 1: the
 * panel does not close on Escape or on an outside click.
 */
import { site } from '../config/site'
import { navLabel, path, useTranslations } from '../i18n/utils'
import { liveNav, type RouteKey } from '../i18n/routes'
import type { Locale } from '../i18n/ui'
import LangSwitch from './LangSwitch.astro'

interface Props {
  locale: Locale
  routeKey: RouteKey
  variant?: 'overlay' | 'solid'
  /** Passed straight through to both LangSwitch instances. Contract lives there. */
  langHref?: string
}

const { locale, routeKey, variant = 'solid', langHref } = Astro.props
const t = useTranslations(locale)

/** Only routes with a built page. See the note on `builtRoutes` in routes.ts. */
const items = liveNav.map((key) => ({
  key,
  href: path(key, locale),
  label: navLabel(key, locale),
}))

/**
 * The accent CTA — the quote form, since Phase 6 built it.
 *
 * This was a conditional on `builtRoutes.has('contact')`, falling back to the
 * phone while no contact page existed. The bridge came down when the page
 * landed: the branch could no longer be taken, and a dead branch is a route
 * back to a state we deliberately left.
 */
/*
 * `short` and `full` differ from here on. They were the same string until the
 * rename, which is why the split looked decorative — it is not. Below 22.5em
 * the pill cannot hold the wordmark and `cta.quote` together; `short` is the
 * label measured to fit. See the note on `.nav__brand` below.
 */
const cta = { href: path('contact', locale), short: t('cta.quoteShort'), full: t('cta.quote') }
---
<header class:list={['site-header', `site-header--${variant}`]}>
  <div class="wrap">
    <div class="nav">
      <a class="nav__brand" href={path('home', locale)}>{site.brand}</a>

      {items.length > 0 && (
        <nav class="nav__desktop" aria-label={t('nav.label')}>
          <ul>
            {items.map((item) => (
              <li>
                <a href={item.href} aria-current={item.key === routeKey ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="nav__actions">
        <span class="nav__lang"><LangSwitch locale={locale} routeKey={routeKey} href={langHref} /></span>
        <a class="btn btn--accent btn--sm nav__cta" href={cta.href}>
          <span class="nav__cta-short">{cta.short}</span>
          <span class="nav__cta-full">{cta.full}</span>
        </a>
      </div>

      <details class="nav__menu">
        <summary class="nav__toggle">
          <span class="visually-hidden">{t('nav.menu')}</span>
          <span class="nav__bars" aria-hidden="true"><i></i><i></i><i></i></span>
        </summary>
        <div class="nav__panel">
          <nav aria-label={t('nav.menu')}>
            <ul>
              <li>
                <a
                  href={path('home', locale)}
                  aria-current={routeKey === 'home' ? 'page' : undefined}
                >
                  {t('nav.home')}
                </a>
              </li>
              {items.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === routeKey ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="nav__panel-foot">
            <a class="nav__panel-phone" href={site.phoneHref}>{site.phone}</a>
            <LangSwitch locale={locale} routeKey={routeKey} href={langHref} />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  /**
   * STICKY, AND STILL ZERO JAVASCRIPT. No scroll listener, no IntersectionObserver,
   * no class toggled on scroll — `position: sticky` and `position: fixed` are the
   * whole mechanism. This is deliberately NOT a fourth client-JS exception and must
   * not become one: a header that changes appearance on scroll is where that would
   * start, and the answer to wanting it is that we do not.
   *
   * THE TWO VARIANTS PIN BY DIFFERENT MEANS, AND THAT IS NOT AN OVERSIGHT.
   * `solid` is in normal flow, so `sticky` is a drop-in that changes no layout.
   * `overlay` is OUT of flow already (it was `absolute`), and the hero's
   * `padding-block-start` of 128px exists precisely to clear it. Making that one
   * `sticky` would put it back INTO the flow, push the hero down by the header's
   * own height, and cut the hero's radial glow off below the pill instead of
   * letting it bleed behind it — direction D's whole opening image. `fixed` keeps
   * it out of flow and pins it, which is the same result `sticky` gives the other
   * pages. Both take `inset-block-start: 0` from the base rule below.
   */
  /**
   * NO BACKGROUND ON THE HEADER ITSELF. The header is a transparent box whose
   * only job is to position the pill; the pill is the entire visible header, and
   * page content is meant to scroll to the top of the viewport above it and to
   * either side of it. A full-width bar behind it was tried and removed: it reads
   * as a browser chrome bar rather than as depth, and it is not what direction D
   * or the reference does.
   *
   * What makes that safe is the pill's own opacity and blur, not a scrim — see
   * the note on `.nav` below. Content passing beside the pill is meant to be
   * fully visible; content passing BEHIND it must be unreadable.
   */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 60;
    padding-block: var(--sp-5);
  }

  /* Out of flow, so the hero still starts at the top of the viewport and its
     radial glow still runs up behind the pill. See the note above on why this
     one is `fixed` rather than `sticky`. */
  .site-header--overlay {
    position: fixed;
    inset-inline: 0;
  }

  /**
   * THERE IS NO `.site-header--solid` RULE, AND ITS ABSENCE IS THE DECISION.
   *
   * Interior pages carried a full-width glass bar with a hairline for one
   * revision, which gave the site two header identities: a bar on `/kkk` and a
   * floating pill on `/`. They are unified on the pill. `solid` now means only
   * "takes the base rule" — `sticky`, transparent, in normal flow — and the
   * class is still emitted so the variant is legible in the DOM and has a hook
   * if one is ever needed.
   *
   * `background: var(--bg)` is what stood on that selector before the header was
   * pinned, and it must not come back: an opaque bar the same colour as the page
   * is invisible at rest and, once content scrolls under it, makes text vanish
   * at an edge that is not drawn. The pill's own opacity is what prevents that
   * now, on every page — see `.nav` below.
   */

  /**
   * THE PILL IS THE HEADER, AND ITS OWN BACKGROUND IS THE ONLY THING STANDING
   * BETWEEN SCROLLING TEXT AND THE NAVIGATION ON TOP OF IT.
   *
   * It carried `--glass` and `blur(14px)` from Phase 1 with NO fallback, which
   * did not matter while the page behind it never moved. It moves now, on every
   * page. Two things changed with that:
   *
   * `--glass` went from 55% to 40% and the blur from 14px to 20px — measured, in
   * that direction deliberately. The blur is what destroys legibility; the alpha
   * only dims. A 20px radius smears a 16px glyph past reconstruction, so the
   * lighter fill costs nothing in readability and buys back the translucency that
   * makes the pill read as glass rather than as a solid chip. Figures and the
   * measurement are in tokens.css next to `--glass`.
   *
   * Opaque `--bg-2` is the FALLBACK, stated first, for browsers with no
   * `backdrop-filter`. `--glass` is that same colour at 40%: translucent with no
   * blur behind it is the one combination that is worse than no glass at all,
   * because the page text and the nav labels overlap at full contrast.
   */
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    background: var(--bg-2);
    border: 1px solid var(--glass-line);
    border-radius: var(--r-pill);
    padding: 9px 9px 9px 22px;
  }

  /* The condition and the property are BOTH unprefixed, deliberately. Writing
     the `-webkit-` alias alongside them made Lightning CSS keep only the alias
     while rewriting the condition to the standard name — a browser that passed
     the test would then have got the translucent background with no blur behind
     it, which is the exact failure this @supports exists to prevent. One name in
     both places cannot drift; the minifier adds whatever prefixes its targets
     need, to the property and the condition together. Verified in `dist/`. */
  @supports (backdrop-filter: blur(1px)) {
    .nav {
      background: var(--glass);
      backdrop-filter: blur(20px);
    }
  }

  /**
   * THE WORDMARK WRAPS BELOW 48em, AND THIS RULE IS NOT ABOUT THE BRAND NAME
   * BEING LONG. Do not delete it if the name ever gets shorter.
   *
   * The pill has never fitted at 320px. Measured against the built site: with
   * the OLD nine-character name it already overflowed the viewport by 21px,
   * from Phase 1 to the rename, unnoticed — nothing in `npm run verify` can
   * see a horizontal scrollbar. The rename deepened it to 91px, which is what
   * finally made it visible.
   *
   * 320px is the width that matters, not 390px: it is still live on small
   * Androids and older iPhones, which is exactly the homeowner this site is
   * for. Numbers at 320px, as document overflow past the viewport:
   *
   *     old name, nowrap ............ +21  (broken, pre-existing)
   *     new name, nowrap ............ +91
   *     new name, wrap only ......... +28  (still broken)
   *     new name, short CTA only .... +16  (still broken)
   *     new name, wrap + short CTA .. -15  (fixed; 15px of headroom)
   *
   * Neither half is sufficient alone — both are required, and -15px is the
   * structural maximum for this page, not a value tuned to scrape past. If you
   * change either the wordmark or `cta.quoteShort`, re-measure at 320px.
   *
   * ESTONIAN IS THE BINDING LOCALE FOR THE CTA BREAKPOINT BELOW, NOT ENGLISH.
   * `Küsi pakkumist` is fourteen characters against `Get a quote`'s eleven, so
   * the Estonian pill runs out of room 26px later. Measured as the width at
   * which the FULL label first clears 10px of headroom, wrap already applied:
   *
   *     EN "Get a quote" ....... 332px  (20.75em)
   *     ET "Küsi pakkumist" .... 358px  (22.375em)   <- binding
   *
   * Do not assume this stays true. It is a property of the two strings, not of
   * the layout: with a longer English label and a shorter Estonian one the
   * roles swap, which is exactly what a trial pair of replacement strings did
   * before they were rejected. Re-measure BOTH locales whenever either changes.
   */
  .nav__brand {
    font-weight: var(--fw-display);
    letter-spacing: -0.03em;
    font-size: 1.12rem;
    color: var(--ink);
    text-decoration: none;
  }

  /* ---- desktop links: shown from 1000px, as in direction D ---- */
  .nav__desktop {
    display: none;
    margin-inline-start: 26px;
  }

  .nav__desktop ul {
    display: flex;
    gap: var(--sp-6);
  }

  .nav__desktop a {
    color: var(--ink-2);
    font-size: var(--step-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav__desktop a:hover,
  .nav__desktop a[aria-current='page'] {
    color: var(--ink);
  }

  /* ---- actions ---- */
  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-inline-start: auto;
  }

  .nav__cta {
    font-size: 0.87rem;
    font-weight: var(--fw-strong);
    white-space: nowrap;
  }

  .nav__cta-full {
    display: none;
  }

  /* Below 48em the pill carries the wordmark, the call CTA and the toggle, and
     nothing else — at 390px there is no room for more. The full number and the
     language switch both live in the panel at that width. */
  .nav__lang {
    display: none;
  }

  /* ---- mobile menu: native <details>, no script ---- */
  .nav__menu {
    position: static;
  }

  .nav__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-pill);
    border: 1px solid var(--pill-line);
    background: var(--pill-fill);
    cursor: pointer;
    list-style: none;
  }

  .nav__toggle::-webkit-details-marker {
    display: none;
  }

  .nav__bars {
    display: grid;
    gap: 4px;
    width: 16px;
  }

  .nav__bars i {
    display: block;
    height: 2px;
    background: var(--ink-2);
    border-radius: 2px;
  }

  .nav__menu[open] .nav__toggle {
    background: var(--accent);
    border-color: var(--accent);
  }

  .nav__menu[open] .nav__bars i {
    background: var(--accent-ink);
  }

  /**
   * THE PANEL MUST BE ABLE TO SCROLL, BECAUSE THE HEADER NO LONGER SCROLLS AWAY.
   *
   * Before it was sticky, an open menu taller than the viewport was still
   * reachable: the whole page scrolled and the panel came with it. Pinned, the
   * panel is pinned too, and anything past the bottom edge — the last links, the
   * phone number, the language switch — is unreachable with no scrollbar to hint
   * that it is there. Six links plus the foot is ~356px, which fits a 568px
   * phone upright and does NOT fit one in landscape, or a 480px-tall Android.
   *
   * 125px is measured, in the same spirit as the 22.5em figures above: the
   * panel's top edge sits 105px below the viewport top at this width (20px of
   * header padding + a 77px pill + the 8px gap), and the remaining 20px is
   * clearance at the foot so the panel does not butt against the screen edge.
   *
   * `dvh` rather than `vh`, so a collapsing mobile URL bar cannot leave the panel
   * taller than the visible viewport. The `vh` floor for browsers that predate
   * `dvh` is in its own @supports block below rather than as a preceding
   * declaration — written the usual way, Lightning CSS deduplicates the pair and
   * only the `dvh` line survives into `dist/`, so the fallback that looked
   * present in this file would not have shipped at all.
   *
   * `overscroll-behavior` stops a flick at the end of the list from scrolling the
   * page underneath.
   */
  .nav__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(100% + var(--sp-2));
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-1);
    padding: var(--sp-4);
    max-block-size: calc(100dvh - 125px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  @supports not (max-block-size: 100dvh) {
    .nav__panel {
      max-block-size: calc(100vh - 125px);
    }
  }

  .nav__panel ul {
    display: grid;
  }

  .nav__panel a {
    display: block;
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-xs);
    color: var(--ink-2);
    font-size: var(--step-body);
    font-weight: var(--fw-medium);
    text-decoration: none;
  }

  .nav__panel a[aria-current='page'] {
    color: var(--ink);
  }

  .nav__panel-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-block-start: var(--sp-3);
    padding-block-start: var(--sp-4);
    border-block-start: 1px solid var(--line);
  }

  .nav__panel-phone {
    color: var(--ink);
    font-weight: var(--fw-strong);
    font-size: var(--step-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  /**
   * THE FULL CTA LABEL FROM 22.5em (360px). The abbreviated one covers only the
   * widths that genuinely cannot hold the full string.
   *
   * This swap sat in the 48em block until now, which meant `cta.quoteShort`
   * showed on everything below 767px — every iPhone at 375px and 390px got the
   * abbreviated label with room to spare. 48em was never measured for this; it
   * was simply the breakpoint that already existed.
   *
   * 22.5em is the smallest clean em value at or above the binding crossing of
   * 358px — see the ET/EN figures above. At 360px Estonian has 12px of headroom
   * and English 15px, both past the 10px bar.
   *
   * Landing exactly on 360px is deliberate: it is the common small-Android
   * width, and putting the breakpoint here is what gives those phones the full
   * label rather than withholding it to 23em. A device reporting a hair under
   * 360px falls back to `Päring`, which fits everywhere down to 320px — a
   * cosmetic degradation, not a broken layout.
   *
   * Root font size is 16px, verified rather than assumed, so 22.5em is exactly
   * 360px. The unit stays em so the breakpoint scales with a reader's text-size
   * preference; the label is what runs out of room, and it scales too.
   */
  @media (min-width: 22.5em) {
    .nav__cta-short {
      display: none;
    }

    .nav__cta-full {
      display: inline;
    }
  }

  @media (min-width: 48em) {
    /* Above 48em there is room for the wordmark on one line, and wrapping it
       would be a worse result than the constraint that forces it below. */
    .nav__brand {
      white-space: nowrap;
    }

    .nav__lang {
      display: block;
    }
  }

  @media (min-width: 1000px) {
    .nav__desktop {
      display: block;
    }

    .nav__menu {
      display: none;
    }
  }
</style>
