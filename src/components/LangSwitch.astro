---
/**
 * Language switch. A real link to a real URL, never a JavaScript toggle —
 * ARCHITECTURE section 2: this matters for indexing.
 *
 * The link text is already written in the target language ("In English" on the
 * Estonian site), so the element carries `lang` and `hreflang` for the locale it
 * points AT, not the one it sits in.
 */
import { path, useTranslations, otherLocale, bcp47 } from '../i18n/utils'
import type { RouteKey } from '../i18n/routes'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  routeKey: RouteKey
  class?: string
  /**
   * The target URL, when the route key cannot produce it. A page with a
   * localised slug — a service, and later a post or a location — must send the
   * reader to the paired slug, not to the section index: from
   * `/teenused/katusepesu` the switch goes to `/en/services/roof-cleaning`, not
   * to `/en/services`. `BaseLayout` derives it from the same alternates it puts
   * in hreflang, so the two can never disagree.
   */
  href?: string
}

const { locale, routeKey, class: className, href } = Astro.props
const t = useTranslations(locale)
const target = otherLocale(locale)
---
<a
  class:list={['lang-switch', className]}
  href={href ?? path(routeKey, target)}
  lang={bcp47(target)}
  hreflang={bcp47(target)}
>
  <span class="visually-hidden">{t('lang.label')}: </span>{t('lang.switch')}
</a>

<style>
  .lang-switch {
    color: var(--ink-2);
    font-size: var(--step-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    white-space: nowrap;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-pill);
    transition: color 0.15s ease;
  }

  .lang-switch:hover {
    color: var(--ink);
  }
</style>
