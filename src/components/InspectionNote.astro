---
/**
 * InspectionNote — the smallest of the three pointers, under the six-card
 * washing grid on `/teenused` and `/en/services`.
 *
 * NOT A CARD, AND THAT IS THE WHOLE DESIGN CONSTRAINT. It sits directly beneath
 * a grid of six service cards, and anything card-shaped there reads as a seventh
 * service — which is exactly what SPEC section 11 forbids: inspection appears
 * wherever the washing set appears as a POINTER, never as a MEMBER. So it is a
 * plain block set off by a rule above it, visibly outside the grid.
 *
 * It is a separate component from `InspectionSection` and `InspectionPricing`
 * rather than one component with a size prop. The three differ in what they have
 * to say — this one only has to establish that inspection exists and is not on
 * the list above — and collapsing them would mean a prop deciding how much copy
 * to render. Copy in `i18n/inspection.ts`; SPEC section 11 binds it.
 */
import { inspectionPointer } from '../i18n/inspection'
import { path } from '../i18n/utils'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = inspectionPointer('services', locale)
const href = path('inspection', locale)
---
<div class="insp-note">
  <h2 class="insp-note__heading">{c.heading}</h2>
  {c.body.map((paragraph) => <p class="insp-note__body">{paragraph}</p>)}
  <p class="insp-note__cta"><a href={href}>{c.cta}</a></p>
</div>

<style>
  /* The rule above is what puts it outside the grid. Without it the block reads
     as a caption belonging to the last card. */
  .insp-note {
    margin-block-start: var(--sp-8);
    padding-block-start: var(--sp-7);
    border-block-start: 1px solid var(--line);
    max-width: var(--measure);
  }

  /* Deliberately smaller than a section heading: this is a note beside the
     grid, not a competing section. The cards above are h2s too — same level,
     different weight, which is a size decision rather than a depth one. */
  .insp-note__heading {
    font-size: var(--step-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-h3);
    font-weight: var(--fw-strong);
  }

  .insp-note__body {
    margin-block-start: var(--sp-3);
    color: var(--ink-2);
    font-size: var(--step-sm);
    line-height: var(--lh-body);
  }

  .insp-note__cta {
    margin-block-start: var(--sp-4);
    font-size: var(--step-sm);
    font-weight: var(--fw-strong);
  }

  .insp-note__cta a {
    color: var(--accent-text);
  }
</style>
