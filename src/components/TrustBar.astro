---
/**
 * TrustBar — direction D's proof strip, which replaces the logo wall a business
 * with no customers yet cannot honestly build.
 *
 * Every claim on it is on CLAUDE.md's permitted list: nobody walks on the roof,
 * the work is insured, we are permitted to fly over houses, the price is
 * published. Nothing here needs a measurement to defend.
 *
 * Direction D's own strip names SORA, SAIL II and the insurance regulation in
 * its fineprint. Those strings do NOT come across — CLAUDE.md is explicit about
 * this file: port its layout, not those strings. The exact references live on
 * the credentials page (Phase 5), where the reader has come looking for
 * documents. The fineprint below says what a KÜ gets, in a homeowner's language,
 * and links nowhere until that page exists.
 *
 * The icons are decoration: every claim they sit beside is also made in text,
 * so they are aria-hidden and carry no alt equivalent.
 */
import { homeCopy } from '../i18n/home'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = homeCopy[locale].trust
const [noWalk, insured, authorised, published] = c.items
---
<section class="section trust">
  <div class="wrap">
    {/* An <h2>, not the <p class="label"> it was until 3 August 2026. It is the
        first section under the page's h1 and its text was always a section
        heading in content terms — it was only SET as furniture, which the band
        removal exposed: with one background and one rhythm, a section is a
        section-sized heading over a body of content, and this was the only one
        opting out. Promoting it is also the semantic fix, since a <p> styled as
        a label put no heading in the outline here at all. */}
    <h2 class="trust__label">{c.label}</h2>

    <ul class="trust__grid">
      <li class="trust__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
        <span><b>{noWalk.lead}</b> {noWalk.rest}</span>
      </li>

      <li class="trust__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9" />
          <path d="M9 12l2 2 4-4" />
        </svg>
        <span><b>{insured.lead}</b> {insured.rest}</span>
      </li>

      <li class="trust__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path d="M3 12l9-9 9 9" />
          <path d="M5 10v10h14V10" />
        </svg>
        <span><b>{authorised.lead}</b> {authorised.rest}</span>
      </li>

      <li class="trust__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18" />
        </svg>
        <span><b>{published.lead}</b> {published.rest}</span>
      </li>
    </ul>

    <p class="fineprint trust__fineprint">{c.fineprint}</p>
  </div>
</section>

<style>
  /* `.trust` has no padding rule of its own any more, and the element now
     carries `.section` instead. It was --sp-7 inside a --bg-2 band, where the
     band's edges did the separating and 32px was enough breathing room inside
     them. With the band gone it takes `.section`'s rhythm like every other
     section on the page — space is the only separator now, and a strip that
     kept a tighter one would read as attached to whichever neighbour it
     happened to be nearer. */

  /* NO `text-align: center`, AND ITS ABSENCE IS THE POINT rather than an
     omission. This heading was centred while the four items and the fineprint
     beneath it were left-aligned, and while every other section heading on the
     page — "Teenused ja hinnad", "Enne ja pärast", the FAQ — is left-aligned
     too. Alignment is part of the same grammar as size and weight, so matching
     one without the other would have left the mismatch half-fixed. Nothing else
     in the strip needed reconciling: the items are flex rows and the fineprint
     is body copy, both already left-aligned. The heading was the outlier.

     --sp-7 rather than the --sp-6 it carried as a micro-label, because a
     2.5rem heading needs more air beneath it than a 0.71rem one. It matches
     `Faq`'s h2-to-body distance, which is the same shape: a section heading
     with content directly under it and no lead paragraph between. */
  .trust__label {
    margin-block-end: var(--sp-7);
  }

  .trust__grid {
    display: grid;
    gap: var(--sp-4);
  }

  .trust__item {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    color: var(--ink-2);
    font-size: var(--step-sm);
    line-height: var(--lh-tight);
  }

  .trust__item svg {
    inline-size: 17px;
    block-size: 17px;
    flex: none;
    margin-block-start: 3px;
    color: var(--accent);
  }

  .trust__item b {
    color: var(--ink);
    font-weight: var(--fw-strong);
  }

  .trust__fineprint {
    margin-block-start: var(--sp-6);
    padding-block-start: var(--sp-5);
    border-block-start: 1px solid var(--line);
  }

  @media (min-width: 760px) {
    .trust__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-5);
    }
  }

  @media (min-width: 1000px) {
    .trust__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
