---
/**
 * FaqList — a disclosure list of questions, and nothing around it.
 *
 * Extracted from `Faq.astro` in Phase 5, when `/kkk` needed the same list three
 * times under three group headings inside one section. `Faq.astro` is the home
 * page's excerpt: a section, a heading, this list, and the link to the full
 * FAQ. The page renders group headings and this list directly.
 *
 * Native <details>, so it costs zero bytes of JavaScript — ARCHITECTURE
 * section 2. A <summary> is not a heading element, so nesting this under an
 * <h2> disturbs no heading order.
 *
 * The copy comes from `i18n/faq.ts` with its tokens already resolved by
 * `faqEntries()`. This component interpolates nothing, which is what keeps the
 * FAQ page's `FAQPage` structured data identical to the visible answer: both
 * are built from the same returned objects.
 */
import { faqEntries, type FaqId } from '../i18n/faq'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  /** Which questions, in order. */
  ids: readonly FaqId[]
}

const { locale, ids } = Astro.props
const items = faqEntries(locale, ids)
---
<div class="faq__list">
  {items.map((item) => (
    <details class="faq__item" id={`kkk-${item.id}`}>
      <summary class="faq__q">
        <span>{item.q}</span>
        <span class="faq__mark" aria-hidden="true"></span>
      </summary>
      <p class="faq__a">{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq__list {
    display: grid;
    gap: var(--sp-3);
  }

  .faq__item {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    padding: var(--sp-4) var(--sp-5);
    font-weight: var(--fw-strong);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  /* A drawn mark rather than a glyph, so it needs no icon font and rotates
     cleanly. It is decoration: the <details> element already announces state. */
  .faq__mark {
    position: relative;
    flex: none;
    inline-size: 12px;
    block-size: 12px;
  }

  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    inline-size: 12px;
    block-size: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: translateY(-50%);
  }

  .faq__mark::after {
    transform: translateY(-50%) rotate(90deg);
    transition: transform 0.15s ease;
  }

  .faq__item[open] .faq__mark::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .faq__a {
    padding: 0 var(--sp-5) var(--sp-5);
    color: var(--ink-3);
    font-size: var(--step-sm);
  }
</style>
