---
/**
 * Where Formspree redirects after a successful POST, Estonian.
 * `en/thank-you.astro` is its pair.
 *
 * `noindex`, and excluded from the sitemap in `astro.config.mjs`. It is only
 * meaningful directly after a submission and has no standalone value in search
 * results; a page that is `noindex` in its head and listed in the sitemap tells
 * a crawler two contradictory things.
 *
 * NOTHING HERE PROMISES A TIMEFRAME. The steps are the same commitments
 * `pricing.ts` already makes — a site visit, then a written binding price —
 * because those are verifiable conduct. "We reply within X" is not a promise
 * this business has made. See `i18n/contact.ts`.
 *
 * PEOPLE REACH THIS PAGE. That was not true until the quote form was given its
 * AJAX submit: the custom `_next` redirect is a Formspree paid feature, so on
 * the free tier a submitter landed on Formspree's own thanks page instead —
 * measured in Phase 6, not assumed. `QuoteForm.astro` now intercepts the submit,
 * POSTs with `fetch`, and navigates here itself, reading the target out of the
 * same `_next` field.
 *
 * WHO STILL DOES NOT GET HERE: a visitor with JavaScript disabled, whose native
 * POST is still redirected by Formspree to its own page. That is the no-JS
 * minority and it is all that is left of the plan-upgrade question — see the
 * blocked list in PLAN. Do not delete this page on the belief that it is
 * unreachable; it is the ordinary destination now.
 *
 * `lendavhollandlane.ee` resolves and serves the site as of 26 July 2026, so
 * the URL this page sits at is a working one. That used to be a second blocker
 * and it no longer is.
 */
import PageLayout from '../layouts/PageLayout.astro'
import { site } from '../config/site'
import { contactContent } from '../i18n/contact'
import { path, useTranslations } from '../i18n/utils'

const locale = 'et' as const
const t = useTranslations(locale)
const c = contactContent(locale).thanks
---
<PageLayout
  title={t('meta.thanks.title')}
  description={t('meta.thanks.description')}
  locale={locale}
  routeKey="thanks"
  heading={t('thanks.heading')}
  lead={c.lead}
  noindex={true}
>
  <section class="section section--tight">
    <div class="wrap thanks">
      <h2>{c.nextHeading}</h2>
      <ol class="thanks__steps">
        {c.next.map((step) => <li>{step}</li>)}
      </ol>

      <p class="thanks__call">
        {c.callLead} <a href={site.phoneHref}>{site.phone}</a>
      </p>

      <p><a class="btn btn--ghost" href={path('home', locale)}>{t('nav.home')}</a></p>
    </div>
  </section>
</PageLayout>

<style>
  .thanks h2 {
    font-size: var(--step-h3);
    letter-spacing: var(--ls-h3);
  }

  .thanks__steps {
    display: grid;
    gap: var(--sp-4);
    counter-reset: step;
    margin-block: var(--sp-6) var(--sp-8);
    max-width: var(--measure);
    color: var(--ink-2);
  }

  .thanks__steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-4);
    line-height: var(--lh-body);
  }

  .thanks__steps li::before {
    content: counter(step);
    color: var(--accent);
    font-weight: var(--fw-strong);
    font-variant-numeric: tabular-nums;
  }

  .thanks__call {
    color: var(--ink-2);
    margin-block-end: var(--sp-8);
  }

  .thanks__call a {
    font-weight: var(--fw-strong);
  }
</style>
