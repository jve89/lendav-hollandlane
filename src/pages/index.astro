---
/**
 * Estonian home page. A composition, nothing more — every string comes from
 * `i18n/home.ts` and `i18n/ui.ts`, every price and contact detail from
 * `config/site.ts`. `en/index.astro` is the same file with a different locale.
 *
 * The header switches to its `overlay` variant here, and only here: the hero is
 * the one section built to have the navigation pill floating over it.
 *
 * The services grid is authored inline this phase. The `services` content
 * collection arrives in Phase 3 and replaces the array in `home.ts`; this file
 * changes only in where it maps from.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import TrustBar from '../components/TrustBar.astro'
import ServiceGrid from '../components/ServiceGrid.astro'
import BeforeAfter from '../components/BeforeAfter.astro'
import InspectionSection from '../components/InspectionSection.astro'
import CompareTable from '../components/CompareTable.astro'
import Faq from '../components/Faq.astro'
import Cta from '../components/Cta.astro'
import { homeCopy } from '../i18n/home'
import { servicesFor } from '../i18n/services'
import { useTranslations, vatNote } from '../i18n/utils'

const locale = 'et' as const
const t = useTranslations(locale)
const c = homeCopy[locale]

/**
 * The service cards, from the content collection rather than an array in
 * `home.ts` — Phase 4. `servicesFor` also runs the locale guard and the
 * completeness assertion, so a mislocated or missing service file stops the
 * home page build, not just the service pages.
 */
const services = await servicesFor(locale)

/**
 * The newest published job, or nothing. Selected rather than hardcoded, so the
 * home page starts showing real evidence the moment a job file lands — Phase 10
 * needs no edit here. Until then this is `undefined` and `BeforeAfter` renders
 * its empty state, which is the launch state.
 */
const publishedJobs = await getCollection('jobs', ({ data }) => data.published)
const latestJob = publishedJobs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0]
---
<BaseLayout
  title={t('meta.home.title')}
  description={t('meta.home.description')}
  locale={locale}
  routeKey="home"
  headerVariant="overlay"
>
  <Hero locale={locale} headline={c.hero.headline} sub={c.hero.sub} />

  <TrustBar locale={locale} />

  <section class="section services">
    <div class="wrap">
      {/* `services.washHeading`, from ui.ts, and the same string `/teenused`
          puts over the same grid. It names the grid as the WASHING set rather
          than as everything we do — inspection is a section below, not a
          seventh card. SPEC section 11. */}
      <h2>{t('services.washHeading')}</h2>
      <p class="lead services__lead">{c.services.lead}</p>
      <ServiceGrid locale={locale} entries={services} />
      <p class="fineprint services__vat">{vatNote(locale)}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{c.work.heading}</h2>
      <BeforeAfter jobId={latestJob?.id} locale={locale} />
    </div>
  </section>

  {/* AFTER the evidence and BEFORE CompareTable, and the order is load-bearing:
      services -> evidence is the washing argument start to finish and nothing
      goes between them. This is where a reader who has finished that argument
      meets the second line of business. It replaced a two-card chooser under
      the hero, which forced an either/or between two sequential things — see
      the note in `i18n/home.ts` where its copy used to live. */}
  <InspectionSection locale={locale} />

  <CompareTable locale={locale} />

  <Faq locale={locale} />

  <Cta locale={locale} />
</BaseLayout>

<style>
  .services__lead {
    margin-block: var(--sp-4) var(--sp-8);
  }

  /* The grid itself, and the reasoning behind flex rather than grid, moved into
     ServiceGrid.astro in Phase 4 — the services index needed the same layout in
     two locales, and four copies of it would have drifted. */

  .services__vat {
    margin-block-start: var(--sp-7);
  }
</style>
