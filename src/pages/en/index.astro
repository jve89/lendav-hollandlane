---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { site } from '../../config/site'
import { useTranslations } from '../../i18n/utils'

const locale = 'en' as const
const t = useTranslations(locale)
---
<BaseLayout
  title={t('meta.home.title')}
  description={t('meta.home.description')}
  locale={locale}
  routeKey="home"
>
  <div class="wrap">
    <h1>{site.brandText}</h1>
    <p>Roof and facade cleaning by drone. Across Estonia.</p>
  </div>
  <!--
    Phase 1 shell only. The hero, the proof strip and the services section
    arrive in Phase 3, and the header switches to variant="overlay" then.
  -->
</BaseLayout>

<style>
  .wrap {
    padding-block: var(--sp-10) var(--sp-12);
  }

  p {
    color: var(--ink-3);
    font-size: var(--step-sub);
    margin-block-start: var(--sp-5);
    max-width: var(--measure-narrow);
  }
</style>
