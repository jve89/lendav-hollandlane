---
/**
 * English home page. Identical composition to `index.astro`, different locale —
 * see the note there. Estonian is the source of truth; the English strings in
 * `i18n/home.ts` are a translation of it, not a parallel original.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Hero from '../../components/Hero.astro'
import PathChooser from '../../components/PathChooser.astro'
import TrustBar from '../../components/TrustBar.astro'
import ServiceGrid from '../../components/ServiceGrid.astro'
import BeforeAfter from '../../components/BeforeAfter.astro'
import CompareTable from '../../components/CompareTable.astro'
import Faq from '../../components/Faq.astro'
import Cta from '../../components/Cta.astro'
import { homeCopy } from '../../i18n/home'
import { servicesFor } from '../../i18n/services'
import { useTranslations, vatNote } from '../../i18n/utils'

const locale = 'en' as const
const t = useTranslations(locale)
const c = homeCopy[locale]

/** The service cards, from the content collection. See the note in `index.astro`. */
const services = await servicesFor(locale)

/** The newest published job, or nothing. See the note in `index.astro`. */
const publishedJobs = await getCollection('jobs', ({ data }) => data.published)
const latestJob = publishedJobs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0]
---
<BaseLayout
  title={t('meta.home.title')}
  description={t('meta.home.description')}
  locale={locale}
  routeKey="home"
  headerVariant="overlay"
>
  <Hero locale={locale} headline={c.hero.headline} sub={c.hero.sub} />

  {/* The two pillars. See the note in `index.astro`. */}
  <PathChooser locale={locale} />

  <TrustBar locale={locale} />

  <section class="section services">
    <div class="wrap">
      <h2>{c.services.heading}</h2>
      <p class="lead services__lead">{c.services.lead}</p>
      <ServiceGrid locale={locale} entries={services} />
      <p class="fineprint services__vat">{vatNote(locale)}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{c.work.heading}</h2>
      <BeforeAfter jobId={latestJob?.id} locale={locale} />
    </div>
  </section>

  <CompareTable locale={locale} />

  <Faq locale={locale} />

  <Cta locale={locale} />
</BaseLayout>

<style>
  .services__lead {
    margin-block: var(--sp-4) var(--sp-8);
  }

  /* The grid moved into ServiceGrid.astro in Phase 4 — see `index.astro`. */

  .services__vat {
    margin-block-start: var(--sp-7);
  }
</style>
