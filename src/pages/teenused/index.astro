---
/**
 * The services index, Estonian. `en/services/index.astro` is its pair.
 *
 * The grid sits directly under the page `<h1>`, so the cards are `<h2>`s —
 * an `<h3>` here would skip a level. CLAUDE.md: headings in order.
 */
import PageLayout from '../../layouts/PageLayout.astro'
import ServiceGrid from '../../components/ServiceGrid.astro'
import Cta from '../../components/Cta.astro'
import { servicesFor } from '../../i18n/services'
import { useTranslations, vatNote } from '../../i18n/utils'

const locale = 'et' as const
const t = useTranslations(locale)
const services = await servicesFor(locale)
---
<PageLayout
  title={t('meta.services.title')}
  description={t('meta.services.description')}
  locale={locale}
  routeKey="services"
  heading={t('services.heading')}
  lead={t('services.lead')}
>
  <section class="section section--paper section--tight">
    <div class="wrap">
      <ServiceGrid locale={locale} entries={services} headingLevel={2} />
      <p class="fineprint services__vat">{vatNote(locale)}</p>
    </div>
  </section>

  <Cta locale={locale} />
</PageLayout>

<style>
  .services__vat {
    margin-block-start: var(--sp-7);
  }
</style>
